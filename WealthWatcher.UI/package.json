{
  "name": "WealthWatcher.UI",
  "private": true,
  "version": "0.16.0",
  "type": "module",
  "scripts": {
    "prepare-release": "node ../scripts/release-notes.mjs generate --output WealthWatcher.UI/public/release.json",
    "dev": "npm run prepare-release && vite",
    "build": "npm run prepare-release && vite build",
    "build:demo": "npm run prepare-release && vite build --mode demo",
    "preview": "vite preview",
    "test": "node --test \"src/**/*.test.js\""
  },
  "devDependencies": {
    "chart.js": "4.6.1",
    "chartjs-plugin-datalabels": "2.2.0",
    "flatpickr": "4.6.13",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "pluralize": "^8.0.0"
  }
}
